/* Steam Shelf — 简体中文 */

/* 空状态与错误 */
"Steam is not installed" = "未安装 Steam";
"Could not find ~/Library/Application Support/Steam." = "找不到 ~/Library/Application Support/Steam。";
"Reading your library…" = "正在读取游戏库…";
"No games installed" = "没有已安装的游戏";
"Games you install in Steam appear here automatically." = "在 Steam 中安装游戏后会自动显示在这里。";

/* 工具栏 */
"Search games" = "搜索游戏";
"Sort" = "排序";
"Name" = "按名称";
"Last Played" = "按最近游玩";
"Size" = "按占用空间";
"Refresh" = "刷新";
"Sync Shortcuts" = "同步快捷方式";
"Creates a .app shortcut in ~/Applications for every installed game, and moves shortcuts for uninstalled games to the Trash." = "为每款已安装的游戏在 ~/Applications 创建 .app 快捷方式，并把已卸载游戏的快捷方式移到废纸篓。";

/* 窗口副标题。中文没有单复数变化，两个键指向同一形式。 */
"1 game" = "1 款游戏";
"%lld games" = "%lld 款游戏";
"%1$lld of %2$@" = "%2$@ 中的 %1$lld 款";

/* 游戏卡片 */
"Never played" = "从未游玩";

/* 右键菜单 */
"Play" = "开始游戏";
"Reveal Install Folder" = "打开安装目录";
"Open Store Page" = "打开商店页面";
"Copy AppID (%@)" = "复制 AppID (%@)";

/* 同步结果 */
"Shortcut sync complete" = "快捷方式同步完成";
"OK" = "好";
"Open Applications Folder" = "打开 Applications 文件夹";
"Nothing to change. Your shortcuts are already up to date." = "无需更改，快捷方式已是最新。";
"Created (%lld)" = "新建 (%lld)";
"Updated (%lld)" = "更新 (%lld)";
"Moved to Trash (%lld)" = "移到废纸篓 (%lld)";
"Skipped (%lld)" = "已跳过 (%lld)";
"%@ — an app with that name already exists and is not a Steam shortcut" = "%@ — 同名应用已存在，且不是 Steam 快捷方式";
"%1$@ — could not be created: %2$@" = "%1$@ — 创建失败：%2$@";
"%1$@ — could not be removed: %2$@" = "%1$@ — 删除失败：%2$@";

"A Steam library could not be read, so shortcuts for games that look uninstalled were left alone. Reconnect the drive and sync again to tidy them up." = "有一个 Steam 库无法读取，因此看起来已卸载的游戏的快捷方式未被处理。重新连接该驱动器后再次同步即可清理。";
